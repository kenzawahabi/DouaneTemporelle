<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_titre_tk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Douane Temporelle"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/et_nom_tk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du voyageur"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/et_naissance_tk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de naissance (ex: 1990)"
        android:inputType="number" />

    <EditText
        android:id="@+id/et_destination_tk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de destination (ex: 2050)"
        android:inputType="number" />

    <TextView
        android:id="@+id/tv_motif_label_tk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Motif du voyage :"
        android:layout_marginTop="16dp" />

    <RadioGroup
        android:id="@+id/rg_motif_tk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_tourisme_tk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/motif_tourisme" />

        <RadioButton
            android:id="@+id/rb_modification_tk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/motif_modification" />

        <RadioButton
            android:id="@+id/rb_fuite_tk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/motif_fuite" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_inspecter_tk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Inspecter le profil" />
</LinearLayout>